# CodeSage AI - Environment Variables Template

# Project
PROJECT_NAME="CodeSage AI"
VERSION="1.0.0"

# Security & Authentication
# Generate a strong 32+ character random secret for production (e.g. openssl rand -hex 32)
SECRET_KEY="dev-codesage-insecure-secret-key-change-in-production-min32chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
# Local Zero-Setup Standalone Dev:
DATABASE_URL="sqlite+aiosqlite:///./codesage.db"
# Production / Docker Compose (PostgreSQL):
# DATABASE_URL="postgresql+asyncpg://codesage:codesage_dev_secret@localhost:5432/codesagedb"
POSTGRES_USER="codesage"
POSTGRES_PASSWORD="codesage_dev_secret"
POSTGRES_DB="codesagedb"

# Vector Database (Qdrant)
# Leave empty for embedded in-memory vector index, or provide Qdrant URL
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION="code_chunks"
EMBEDDING_DIMENSION=384

# Task Queue (Redis & Celery)
REDIS_URL=""
USE_IN_PROCESS_TASKS=true

# AI Providers
# Options: "mock" (offline testing, no API keys needed), "openai", "anthropic", "gemini", "ollama"
LLM_PROVIDER="mock"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_BASE_URL=""

# Embeddings Provider
# Options: "mock", "openai", "gemini"
EMBEDDING_PROVIDER="mock"
EMBEDDING_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"

# Ingestion Security & Limits
MAX_UPLOAD_SIZE_MB=50
MAX_FILE_COUNT=1500
MAX_REPO_DISK_MB=250

# Frontend Next.js Public Endpoint
NEXT_PUBLIC_API_URL="http://localhost:8000/api"
